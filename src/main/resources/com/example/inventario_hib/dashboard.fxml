<AnchorPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #131d39;" stylesheets="@../../../estilos/estilos.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladores.DashboardController">
