<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="950.0"
            style="-fx-background-color: #131d39;" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladores.gestionmodulos.productos.ProductosController">
    <stylesheets>
        <URL value="@../../../../../estilos/estilos.css"/>
        <URL value="@../../../../../estilos/tabla.css"/>
    </stylesheets>
    <MenuBar layoutY="2.0" prefHeight="26.0" prefWidth="950.0" styleClass="menu-bar" AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Menu id="opcionAccesibilidad" mnemonicParsing="false" styleClass="menu-item" text="Herramientas">
            <MenuItem mnemonicParsing="false" onAction="#abrirAccesibilidad" text="Accesibilidad"/>
            <MenuItem mnemonicParsing="false" onAction="#abrirConfiguracion" text="Configuración"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Ayuda">
            <MenuItem mnemonicParsing="false" onAction="#abrirAyuda" text="Manual de Usuario"/>
            <MenuItem mnemonicParsing="false" onAction="#mostrarMensajeNoDisponible" text="Acerca de"/>
            <MenuItem mnemonicParsing="false" onAction="#mostrarMensajeNoDisponible" text="Soporte Técnico"/>
            <MenuItem mnemonicParsing="false" onAction="#mostrarMensajeNoDisponible" text="Actualizaciones"/>
        </Menu>
    </MenuBar>
    <Label alignment="CENTER" layoutX="302.0" layoutY="54.0" prefHeight="54.0" prefWidth="344.0" styleClass="bold"
           text="GESTIÓN DE PRODUCTOS" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="302.0"
           AnchorPane.rightAnchor="303.5999999999999">
        <font>
            <Font name="Calibri Bold" size="30.0"/>
        </font>
    </Label>
    <HBox alignment="CENTER" layoutX="21.0" layoutY="130.0" prefHeight="66.0" prefWidth="912.0">
        <HBox alignment="CENTER" onMouseClicked="#crearProducto" prefHeight="44.0" prefWidth="164.0"
              styleClass="hbox">
            <HBox.margin>
                <Insets bottom="10.0" right="25.0" top="10.0"/>
            </HBox.margin>
            <Label alignment="CENTER" onMouseClicked="#crearProducto" prefHeight="24.0" prefWidth="156.0"
                   text="Crear producto" textFill="WHITE">
                <font>
                    <Font name="Imprint MT Shadow" size="20.0"/>
                </font>
                <HBox.margin>
                    <Insets/>
                </HBox.margin>
            </Label>
        </HBox>
        <HBox alignment="CENTER" onMouseClicked="#modificarProducto" prefHeight="100.0" styleClass="hbox">
            <HBox.margin>
                <Insets bottom="10.0" right="25.0" top="10.0"/>
            </HBox.margin>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Modificar producto" textFill="WHITE">
                <font>
                    <Font name="Imprint MT Shadow" size="20.0"/>
                </font>
                <HBox.margin>
                    <Insets/>
                </HBox.margin>
            </Label>
        </HBox>
        <HBox alignment="CENTER" onMouseClicked="#eliminarProducto" prefHeight="100.0" styleClass="hbox">
            <HBox.margin>
                <Insets bottom="10.0" top="10.0"/>
            </HBox.margin>
            <Label alignment="CENTER" text="Eliminar producto" textFill="WHITE">
                <font>
                    <Font name="Imprint MT Shadow" size="20.0"/>
                </font>
                <HBox.margin>
                    <Insets/>
                </HBox.margin>
            </Label>
        </HBox>
    </HBox>
    <TableView fx:id="tablaDeProductos" layoutX="173.0" layoutY="209.0" prefHeight="230.0" prefWidth="604.0"
               stylesheets="@../../../../../estilos/tabla.css">
        <columns>
          <TableColumn fx:id="columnaIdProducto" prefWidth="142.40003967285156" text="ID"/>
          <TableColumn fx:id="columnaDescripcion" prefWidth="134.39996337890625" text="DESCRIPCIÓN"/>
          <TableColumn fx:id="columnaKeyRFID" prefWidth="177.5999755859375" text="KEYRFID"/>
          <TableColumn fx:id="columnaEAN13" minWidth="0.0" prefWidth="144.0" text="EAN13"/>
        </columns>
    </TableView>
    <Label alignment="CENTER" layoutX="99.0" layoutY="463.0" prefHeight="23.0" prefWidth="183.0" styleClass="bold"
           text="FILTRAR POR DATOS" textAlignment="CENTER" textFill="WHITE">
        <font>
          <Font name="Calibri Bold" size="20.0"/>
        </font>
    </Label>
    <TextField fx:id="txtRFID" alignment="CENTER" layoutX="302.0" layoutY="499.0" prefHeight="27.0" prefWidth="183.0"
               promptText="KEYRFID" style="-fx-background-radius: 5;">
        <font>
          <Font name="Calibri Bold" size="14.0"/>
        </font>
    </TextField>
    <TextField fx:id="txtDescripcion" alignment="CENTER" layoutX="99.0" layoutY="498.0" prefHeight="28.0"
               prefWidth="183.0" promptText="DESCRIPCIÓN" style="-fx-background-radius: 5;">
        <font>
          <Font name="Calibri Bold" size="14.0"/>
        </font>
    </TextField>
    <Button layoutX="711.0" layoutY="560.0" mnemonicParsing="false" onAction="#volver" prefHeight="26.0"
            prefWidth="219.0" text="VOLVER AL APARTADO DE GESTIÓN">
        <font>
          <Font name="Calibri Bold" size="12.0"/>
        </font>
    </Button>
    <Button layoutX="560.0" layoutY="560.0" mnemonicParsing="false" onAction="#limpiar" prefHeight="26.0"
            prefWidth="136.0" text="LIMPIAR FILTROS">
        <font>
          <Font name="Calibri Bold" size="12.0"/>
        </font>
    </Button>
</AnchorPane>
