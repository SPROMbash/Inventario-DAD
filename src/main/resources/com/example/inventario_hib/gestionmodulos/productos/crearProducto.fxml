      <TextField fx:id="txtDescripcion" layoutX="61.0" layoutY="199.0" prefHeight="37.0" prefWidth="598.0" promptText="DESCRIPCIÓN">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <Label layoutX="62.0" layoutY="276.0" text="EAN13" textFill="WHITE">
         <font>
            <Font name="Calibri Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtEAN13" layoutX="61.0" layoutY="311.0" prefHeight="37.0" prefWidth="598.0" promptText="EAN13">
