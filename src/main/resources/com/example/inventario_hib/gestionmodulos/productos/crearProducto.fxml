                  <MenuItem mnemonicParsing="false" onAction="#abrirAyuda" text="Abrir Ayuda..." />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <Label alignment="CENTER" layoutX="290.0" layoutY="78.0" styleClass="bold" text="CREAR PRODUCTOS" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <Label layoutX="61.0" layoutY="164.0" prefHeight="23.0" prefWidth="121.0" text="DESCRIPCIÓN" textFill="WHITE">
