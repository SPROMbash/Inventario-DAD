<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #131d39;"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladores.productoCategoria.CrearProductoCategoriaController">
    <MenuBar layoutY="2.0" styleClass="menu-bar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
             AnchorPane.topAnchor="0.0">
        <Menu id="opcionAccesibilidad" mnemonicParsing="false" styleClass="menu-item" text="Accesibilidad">
            <MenuItem mnemonicParsing="false" onAction="#abrirAccesibilidad" text="Abrir Accesibilidad..."/>
        </Menu>
        <Menu id="opcionAyuda" mnemonicParsing="false" styleClass="menu-item" text="Ayuda">
            <MenuItem mnemonicParsing="false" onAction="#abrirAyuda" text="Abrir Ayuda..."/>
        </Menu>
    </MenuBar>
    <Label alignment="CENTER" layoutX="51.0" layoutY="77.0" prefHeight="54.0" prefWidth="724.0" styleClass="bold"
           text="AÑADIR PRODUCTO A UNA CATEGORÍA" textAlignment="CENTER" textFill="WHITE">
        <font>
          <Font name="System Bold" size="36.0"/>
        </font>
    </Label>
    <Label layoutX="61.0" layoutY="164.0" prefHeight="23.0" prefWidth="121.0" text="ID PRODUCTO" textFill="WHITE">
        <font>
          <Font name="Calibri Bold" size="20.0"/>
        </font>
    </Label>
    <Label layoutX="62.0" layoutY="243.0" text="ID CATEGORÍA" textFill="WHITE">
        <font>
          <Font name="Calibri Bold" size="20.0"/>
        </font>
    </Label>
    <Button layoutX="837.0" layoutY="560.0" mnemonicParsing="false" onAction="#volver" prefHeight="26.0"
            prefWidth="93.0" text="VOLVER">
        <font>
          <Font name="Calibri Bold" size="12.0"/>
        </font>
    </Button>
    <Button layoutX="686.0" layoutY="560.0" mnemonicParsing="false" onAction="#anadirProductoporCategoria"
            prefHeight="26.0" prefWidth="136.0" text="AÑADIR PRODUCTO">
        <font>
          <Font name="Calibri Bold" size="12.0"/>
        </font>
    </Button>
    <ImageView fitHeight="59.0" fitWidth="64.0" layoutX="775.0" layoutY="75.0" pickOnBounds="true" preserveRatio="true">
        <image>
          <Image url="@../../../../../img/Designer.png"/>
        </image>
    </ImageView>
    <ComboBox fx:id="comboBoxIdProductos" layoutX="57.0" layoutY="194.0" prefHeight="23.0" prefWidth="252.0"
              promptText="ID DEL PRODUCTO"/>
    <ComboBox fx:id="comboBoxIdCategorias" layoutX="57.0" layoutY="274.0" prefHeight="23.0" prefWidth="252.0"
              promptText="ID DE LA CATEGORÍA"/>
</AnchorPane>
